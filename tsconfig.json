{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/core/config/env.d.ts",
    "src/core/config/components.d.ts",
    "src/core/config/auto-imports.d.ts",
    "src/**/*"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}
